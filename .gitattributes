# Normalise to LF in the repository; check out native on Windows.
* text=auto

# Anything executed by a shell must stay LF even on a Windows checkout —
# a CRLF shebang fails on Linux with "bad interpreter: /usr/bin/env bash^M".
*.sh text eol=lf

# Keep these byte-identical across platforms so diffs stay readable.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.csv text eol=lf

*.jpg binary
*.jpeg binary
*.png binary
*.pt binary
