# Copy to .env and fill in one provider. .env is gitignored and must stay that way;
# CI fails the build if it is ever tracked, or if a real key appears in this file.

# ---- Vision provider -------------------------------------------------------
VLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hosted model names are retired on a rolling basis. If every call starts failing
# with vlm_model_unavailable, run: python manage.py check_vlm --list-models
GEMINI_MODEL=gemini-3.1-flash-lite

# Leave True to click through the whole product with canned reads and no key.
VLM_DRY_RUN=True
SCAN_USE_STUB=False

# ---- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-change-me
APP_SHARED_TOKEN=dev-token
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Expo picks a new port when 8081 is taken; add whichever it reports.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083,http://localhost:19006,http://127.0.0.1:19006

# ---- Cost and abuse controls ----------------------------------------------
MAX_VLM_CALLS_PER_SCAN=10
MAX_UPLOAD_SIZE_MB=8
VLM_TIMEOUT_SECONDS=15
VLM_MAX_RETRIES=1
VLM_MAX_IMAGE_EDGE=512
DAILY_SPEND_CAP_USD=5.00
DAILY_VLM_CALLS_CAP=50
SCAN_RATE_LIMIT=10/min

# Crops are read in parallel; stage 2 is ~8x slower at 1. Lower it if the
# provider starts rate limiting you.
VLM_CONCURRENCY=5

# ---- Stage 1 local detector ------------------------------------------------
# auto (YOLO then OpenCV) | yolo | opencv
# YOLO needs requirements-detector.txt installed; without it, auto uses OpenCV.
DETECTOR_BACKEND=auto
YOLO_MIN_CONFIDENCE=0.15
YOLO_IMAGE_SIZE=640
INCLUDE_CROP_THUMBNAILS=True
CROP_THUMBNAIL_MAX_EDGE=160

# Scores at or above this are auto-accepted; below goes to human review.
CONFIDENCE_THRESHOLD=0.85
